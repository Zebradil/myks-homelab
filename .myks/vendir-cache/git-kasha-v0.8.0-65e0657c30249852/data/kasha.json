{
  "uid": "kasha",
  "title": "kasha",
  "description": "Box state and traffic from kasha's /metrics endpoint.",
  "tags": ["kasha", "nix"],
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": { "query": "label_values(kasha_objects, job)", "refId": "job" },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "flake",
        "label": "Flake",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": { "query": "label_values(kasha_flake_gaps{job=\"$job\"}, flake)", "refId": "flake" },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Objects",
      "description": "Narinfos in the box's index.",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "refId": "A", "expr": "kasha_objects{job=\"$job\"}", "instant": true }],
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "text" } }
      },
      "options": { "graphMode": "none", "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Pending mirror-up",
      "description": "Local-origin generations not yet mirrored to the remote cache. Brief nonzero values are normal after a push; one that stays above zero means mirror-up is stuck.",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "refId": "A", "expr": "kasha_pending_mirror_up{job=\"$job\"}", "instant": true }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 }
            ]
          }
        }
      },
      "options": { "graphMode": "none", "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Oldest flake sync",
      "description": "Age of the stalest flake's last mirror-down. Healthy is under KASHA_SYNC_INTERVAL plus the cycle's run time; red past 1h matches the KashaSyncStale alert.",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - min(kasha_flake_last_sync_timestamp_seconds{job=\"$job\"})",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "no sync yet",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 3600 }
            ]
          }
        }
      },
      "options": { "graphMode": "none", "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Gaps",
      "description": "Closure paths across all flakes' manifests that no source could supply. Usually expected, never an error.",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "refId": "A", "expr": "sum(kasha_flake_gaps{job=\"$job\"})", "instant": true }],
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "text" } }
      },
      "options": { "graphMode": "none", "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Narinfo hit ratio",
      "description": "Share of narinfo lookups the box answered itself over the selected time range.",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(kasha_narinfo_requests_total{job=\"$job\", result=\"hit\"}[$__range])) / sum(increase(kasha_narinfo_requests_total{job=\"$job\"}[$__range]))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "noValue": "no requests",
          "color": { "mode": "fixed", "fixedColor": "text" }
        }
      },
      "options": { "graphMode": "none", "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Last box GC sweep",
      "description": "Age of the last box GC sweep attempt. Red past 2 days matches the KashaSweepStale alert.",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "time() - kasha_last_sweep_timestamp_seconds{job=\"$job\"}", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "never",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 172800 }
            ]
          }
        }
      },
      "options": { "graphMode": "none", "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Narinfo requests",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(kasha_narinfo_requests_total{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Narinfo hit ratio",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(kasha_narinfo_requests_total{job=\"$job\", result=\"hit\"}[$__rate_interval])) / sum(rate(kasha_narinfo_requests_total{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "hit ratio"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "options": { "legend": { "showLegend": false }, "tooltip": { "mode": "single" } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Time since last sync, per flake",
      "description": "Dashed line at 1h: the KashaSyncStale threshold.",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - kasha_flake_last_sync_timestamp_seconds{job=\"$job\", flake=~\"$flake\"}",
          "legendFormat": "{{flake}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "thresholdsStyle": { "mode": "dashed" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "red", "value": 3600 }
            ]
          }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Gaps, per flake",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "kasha_flake_gaps{job=\"$job\", flake=~\"$flake\"}",
          "legendFormat": "{{flake}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "decimals": 0 } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Ingest requests",
      "description": "Pushes by result: accepted, rejected (bad content or signature) or unauthorized.",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(kasha_ingest_requests_total{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Pending mirror-up",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "kasha_pending_mirror_up{job=\"$job\"}", "legendFormat": "pending" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "decimals": 0 } },
      "options": { "legend": { "showLegend": false }, "tooltip": { "mode": "single" } }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Objects",
      "description": "Narinfos in the box's index.",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "refId": "A", "expr": "kasha_objects{job=\"$job\"}", "legendFormat": "objects" }],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "legend": { "showLegend": false }, "tooltip": { "mode": "single" } }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Box GC deletions",
      "description": "Narinfos and NARs deleted by box GC sweeps.",
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(kasha_sweep_deleted_objects_total{job=\"$job\"}[$__interval]))",
          "legendFormat": "deleted",
          "interval": "5m"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "decimals": 0, "custom": { "drawStyle": "bars", "fillOpacity": 80 } }
      },
      "options": { "legend": { "showLegend": false }, "tooltip": { "mode": "single" } }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Time since newest generation was published, per branch",
      "description": "Age of the newest manifest's timestamp: when CI or a local push last produced something for the branch. Unlike last sync, this only resets when there is new data.",
      "gridPos": { "x": 0, "y": 36, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - kasha_generation_published_timestamp_seconds{job=\"$job\", flake=~\"$flake\"}",
          "legendFormat": "{{flake}}/{{branch}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Time since the box received a new generation, per branch",
      "description": "Age of the newest manifest file on the box: when mirror-down (or a push) last brought a new generation. Survives restarts.",
      "gridPos": { "x": 12, "y": 36, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - kasha_generation_arrived_timestamp_seconds{job=\"$job\", flake=~\"$flake\"}",
          "legendFormat": "{{flake}}/{{branch}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 17,
      "type": "table",
      "title": "Newest generation per branch",
      "description": "Published: manifest timestamp. Arrived: when the box stored it. Lag: arrival minus publish, i.e. how long replication took (negative when the box's clock is behind the producer's).",
      "gridPos": { "x": 0, "y": 44, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - kasha_generation_published_timestamp_seconds{job=\"$job\", flake=~\"$flake\"}",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "time() - kasha_generation_arrived_timestamp_seconds{job=\"$job\", flake=~\"$flake\"}",
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "kasha_generation_arrived_timestamp_seconds{job=\"$job\", flake=~\"$flake\"} - kasha_generation_published_timestamp_seconds{job=\"$job\", flake=~\"$flake\"}",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "Since published", "desc": false }] },
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "job": true, "instance": true, "__name__": true },
            "renameByName": {
              "Value #A": "Since published",
              "Value #B": "Since arrived",
              "Value #C": "Replication lag"
            },
            "indexByName": { "flake": 0, "branch": 1, "Value #A": 2, "Value #B": 3, "Value #C": 4 }
          }
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "NAR throughput",
      "description": "NAR bytes per second. down: fetched by mirror-down, by source. up: mirrored to the remote cache. served: sent to clients. ingest: pushed into the box. Counted when a transfer completes, so one large NAR shows as a spike.",
      "gridPos": { "x": 0, "y": 52, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (direction, source) (rate(kasha_nar_bytes_total{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{direction}} {{source}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps", "min": 0 } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 19,
      "type": "bargauge",
      "title": "NAR bytes moved in range",
      "description": "Total NAR bytes per direction over the dashboard's time range.",
      "gridPos": { "x": 12, "y": 52, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (direction, source) (increase(kasha_nar_bytes_total{job=\"$job\"}[$__range]))",
          "legendFormat": "{{direction}} {{source}}",
          "instant": true
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 20,
      "type": "bargauge",
      "title": "NARs by age",
      "description": "NAR count per age bucket (time since the box stored the file; bucket labels are upper bounds). Refreshed at most every 5 minutes.",
      "gridPos": { "x": 0, "y": 60, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "kasha_nar_age_objects{job=\"$job\"}",
          "legendFormat": "{{le}}",
          "format": "heatmap",
          "instant": true
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": {
        "orientation": "vertical",
        "displayMode": "basic",
        "showUnfilled": false,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 21,
      "type": "bargauge",
      "title": "NAR bytes by age",
      "description": "Disk used per age bucket (time since the box stored the file; bucket labels are upper bounds).",
      "gridPos": { "x": 12, "y": 60, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "kasha_nar_age_bytes{job=\"$job\"}",
          "legendFormat": "{{le}}",
          "format": "heatmap",
          "instant": true
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "options": {
        "orientation": "vertical",
        "displayMode": "basic",
        "showUnfilled": false,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "NAR age",
      "description": "Oldest and newest NAR on disk, plus median and 90th percentile age estimated from the buckets (coarse: interpolated within a bucket).",
      "gridPos": { "x": 0, "y": 68, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "expr": "time() - kasha_nar_oldest_timestamp_seconds{job=\"$job\"}", "legendFormat": "oldest" },
        { "refId": "B", "expr": "histogram_quantile(0.9, kasha_nar_age_objects{job=\"$job\"})", "legendFormat": "p90" },
        { "refId": "C", "expr": "histogram_quantile(0.5, kasha_nar_age_objects{job=\"$job\"})", "legendFormat": "p50" },
        { "refId": "D", "expr": "time() - kasha_nar_newest_timestamp_seconds{job=\"$job\"}", "legendFormat": "newest" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    }
  ]
}
