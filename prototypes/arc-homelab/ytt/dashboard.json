{
  "uid": "homelab-runners",
  "title": "Homelab runners",
  "tags": [
    "arc",
    "ci",
    "github-actions"
  ],
  "description": "ARC scale sets on the homelab cluster (runs-on: homelab) and the daddy host their builds run on.",
  "schemaVersion": 42,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "repository",
        "label": "Repository",
        "datasource": {
          "type": "prometheus"
        },
        "query": "label_values(gha_max_runners, repository)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "type": "constant",
        "name": "daddy",
        "query": "192.168.0.101:9100",
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Now",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Running jobs",
      "datasource": {
        "type": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(gha_running_jobs{repository=~\"$repository\"})",
          "legendFormat": "__auto",
          "datasource": {
            "type": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Waiting jobs",
      "datasource": {
        "type": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(gha_assigned_jobs{repository=~\"$repository\"} - gha_running_jobs{repository=~\"$repository\"})",
          "legendFormat": "__auto",
          "datasource": {
            "type": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "description": "Jobs GitHub assigned to a homelab scale set that no runner has picked up yet. HomelabRunnerJobsPending fires after 10 minutes above zero."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Runner pods",
      "datasource": {
        "type": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(kube_resourcequota{namespace=\"arc-homelab\",resourcequota=\"runners\",resource=\"pods\",type=\"used\"})",
          "legendFormat": "__auto",
          "datasource": {
            "type": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "description": "Pods counted against the `runners` ResourceQuota (hard limit 4, shared by all repositories)."
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Listeners",
      "datasource": {
        "type": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(gha_controller_running_listeners)",
          "legendFormat": "__auto",
          "datasource": {
            "type": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "description": "Listener pods the ARC controller reports running, one per repository. Without its listener a repository's jobs stay queued."
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Jobs completed",
      "datasource": {
        "type": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(gha_completed_jobs_total{repository=~\"$repository\"}[$__range])) or vector(0)",
          "legendFormat": "__auto",
          "datasource": {
            "type": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "description": "Over the selected time range. Listener restarts reset the counter; increase() absorbs that."
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Jobs not succeeded",
      "datasource": {
        "type": "prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(gha_completed_jobs_total{repository=~\"$repository\", job_result!=\"succeeded\"}[$__range])) or vector(0)",
          "legendFormat": "__auto",
          "datasource": {
            "type": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "description": "Failed, cancelled or skipped jobs over the selected time range."
    },
    {
      "id": 8,
      "type": "row",
      "title": "Scale sets",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Jobs by repository",
      "datasource": {
        "type": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (repository) (gha_assigned_jobs{repository=~\"$repository\"})",
          "legendFormat": "{{repository}} assigned",
          "datasource": {
            "type": "prometheus"
          },
          "refId": "A"
        },
        {
          "expr": "sum by (repository) (gha_running_jobs{repository=~\"$repository\"})",
          "legendFormat": "{{repository}} running",
          "datasource": {
            "type": "prometheus"
          },
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {},
      "description": "Assigned above running means jobs are waiting for a runner pod."
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Runners",
      "datasource": {
        "type": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(gha_desired_runners{repository=~\"$repository\"})",
          "legendFormat": "desired",
          "datasource": {
            "type": "prometheus"
          },
          "refId": "A"
        },
        {
          "expr": "sum(gha_registered_runners{repository=~\"$repository\"})",
          "legendFormat": "registered",
          "datasource": {
            "type": "prometheus"
          },
          "refId": "B"
        },
        {
          "expr": "sum(gha_busy_runners{repository=~\"$repository\"})",
          "legendFormat": "busy",
          "datasource": {
            "type": "prometheus"
          },
          "refId": "C"
        },
        {
          "expr": "sum(gha_controller_pending_ephemeral_runners{repository=~\"$repository\"}) or vector(0)",
          "legendFormat": "pending pods",
          "datasource": {
            "type": "prometheus"
          },
          "refId": "D"
        },
        {
          "expr": "sum(gha_controller_failed_ephemeral_runners{repository=~\"$repository\"}) or vector(0)",
          "legendFormat": "failed",
          "datasource": {
            "type": "prometheus"
          },
          "refId": "E"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {},
      "description": "Desired comes from the listener, registered and busy from GitHub, pending and failed from the controller's EphemeralRunner objects."
    },
    {
      "id": 11,
      "type": "row",
      "title": "Jobs",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Jobs completed per hour",
      "datasource": {
        "type": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (job_result) (increase(gha_completed_jobs_total{repository=~\"$repository\"}[1h]))",
          "legendFormat": "{{job_result}}",
          "interval": "1h",
          "datasource": {
            "type": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Queue time (assigned to started)",
      "datasource": {
        "type": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 15,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (increase(gha_job_startup_duration_seconds_bucket{repository=~\"$repository\"}[1h])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus"
          },
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (increase(gha_job_startup_duration_seconds_bucket{repository=~\"$repository\"}[1h])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus"
          },
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "description": "ARC's job startup duration: from GitHub assigning the job to the runner starting it, so it includes pod scheduling, image pull and runner registration. Hourly windows; histogram buckets make it approximate."
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Job duration by repository",
      "datasource": {
        "type": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 15,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (repository, le) (increase(gha_job_execution_duration_seconds_bucket{repository=~\"$repository\"}[1h])))",
          "legendFormat": "{{repository}} p50",
          "datasource": {
            "type": "prometheus"
          },
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (repository, le) (increase(gha_job_execution_duration_seconds_bucket{repository=~\"$repository\"}[1h])))",
          "legendFormat": "{{repository}} p95",
          "datasource": {
            "type": "prometheus"
          },
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "description": "Hourly windows; histogram buckets make it approximate."
    },
    {
      "id": 15,
      "type": "table",
      "title": "Jobs over the time range",
      "datasource": {
        "type": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (repository, job_name) (increase(gha_completed_jobs_total{repository=~\"$repository\"}[$__range]))",
          "legendFormat": "__auto",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus"
          },
          "refId": "A"
        },
        {
          "expr": "sum by (repository, job_name) (increase(gha_completed_jobs_total{repository=~\"$repository\", job_result!=\"succeeded\"}[$__range]))",
          "legendFormat": "__auto",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus"
          },
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.5, sum by (repository, job_name, le) (increase(gha_job_startup_duration_seconds_bucket{repository=~\"$repository\"}[$__range])))",
          "legendFormat": "__auto",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus"
          },
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.5, sum by (repository, job_name, le) (increase(gha_job_execution_duration_seconds_bucket{repository=~\"$repository\"}[$__range])))",
          "legendFormat": "__auto",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus"
          },
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Median.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Runs",
            "desc": true
          }
        ]
      },
      "description": "Per workflow job. Medians come from histogram buckets, so they are approximate.",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Runs",
              "Value #B": "Not succeeded",
              "Value #C": "Median queue time",
              "Value #D": "Median duration",
              "repository": "Repository",
              "job_name": "Job"
            }
          }
        }
      ]
    },
    {
      "id": 16,
      "type": "row",
      "title": "Resources",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Runner pod CPU",
      "datasource": {
        "type": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"arc-homelab\",container=\"runner\"}[$__rate_interval]))",
          "legendFormat": "{{pod}}",
          "datasource": {
            "type": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      },
      "options": {},
      "description": "Request 1 core, no CPU limit."
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Runner pod memory",
      "datasource": {
        "type": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 32,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"arc-homelab\",container=\"runner\"})",
          "legendFormat": "{{pod}}",
          "datasource": {
            "type": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {},
      "description": "Request 2 GiB, limit 6 GiB."
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "daddy CPU and memory",
      "datasource": {
        "type": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "expr": "1 - avg(rate(node_cpu_seconds_total{instance=\"$daddy\",mode=\"idle\"}[$__rate_interval]))",
          "legendFormat": "CPU busy",
          "datasource": {
            "type": "prometheus"
          },
          "refId": "A"
        },
        {
          "expr": "1 - node_memory_MemAvailable_bytes{instance=\"$daddy\"} / node_memory_MemTotal_bytes{instance=\"$daddy\"}",
          "legendFormat": "memory used",
          "datasource": {
            "type": "prometheus"
          },
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {},
      "description": "daddy runs the nixci builds (and later BuildKit), plus kasha and Jellyfin."
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "daddy disk I/O",
      "datasource": {
        "type": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 32,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (device) (rate(node_disk_read_bytes_total{instance=\"$daddy\",device!~\"loop.*|zram.*\"}[$__rate_interval]))",
          "legendFormat": "{{device}} read",
          "datasource": {
            "type": "prometheus"
          },
          "refId": "A"
        },
        {
          "expr": "-sum by (device) (rate(node_disk_written_bytes_total{instance=\"$daddy\",device!~\"loop.*|zram.*\"}[$__rate_interval]))",
          "legendFormat": "{{device}} write",
          "datasource": {
            "type": "prometheus"
          },
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {},
      "description": "Writes plotted below zero."
    }
  ]
}
